# Storage for large direct video uploads (created automatically when a Vercel Blob store is connected)
BLOB_READ_WRITE_TOKEN=

# Vercel AI Gateway is the default provider on Vercel deployments.
# Production/Preview deployments receive VERCEL_OIDC_TOKEN automatically.
AI_PROVIDER_ORDER=gateway,groq,gemini,openai

# Optional direct-provider fallbacks. Not required when AI Gateway is available.
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional: persistent AI Gateway API key (not required on Vercel)
AI_GATEWAY_API_KEY=

OPENAI_API_KEY=
ALLOW_PAID_FALLBACK=false
PAID_FALLBACK_MAX_USD=0

# Optional: use the official OpusClip API as the YouTube import + clipping engine.
# This makes the URL workflow behave much more like OpusClip and avoids running
# the YouTube downloader inside your Vercel Sandbox.
OPUSCLIP_API_KEY=
OPUSCLIP_ORG_ID=
OPUSCLIP_MODEL=ClipAnything

# Optional YouTube authentication for videos your account is authorized to access.
# Prefer base64 Netscape-format cookies in YOUTUBE_COOKIES_B64.
# Never commit real cookies or paste them into chat.
YOUTUBE_COOKIES_B64=
# Raw Netscape-format cookie text is also accepted when base64 is inconvenient.
YOUTUBE_COOKIES=
# Optional: match the browser user-agent used when exporting the cookies.
YOUTUBE_USER_AGENT=

GATEWAY_TRANSCRIBE_MODEL=openai/gpt-4o-mini-transcribe
GATEWAY_CLIP_MODEL=openai/gpt-oss-120b
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
GROQ_CLIP_MODEL=openai/gpt-oss-120b
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
GEMINI_CLIP_MODEL=gemini-3.5-flash-lite
