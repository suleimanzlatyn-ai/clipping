# Free-first AI provider routing
AI_PROVIDER_ORDER=groq,gemini,openai
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional paid fallback. Keep false/0 until you intentionally want paid usage.
OPENAI_API_KEY=
ALLOW_PAID_FALLBACK=false
PAID_FALLBACK_MAX_USD=0

# Optional model overrides
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
GROQ_CLIP_MODEL=openai/gpt-oss-120b
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
GEMINI_CLIP_MODEL=gemini-3.5-flash-lite